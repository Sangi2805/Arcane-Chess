# ============================================================================
# Arcane Chess Environment Configuration
# ============================================================================
#
# This file defines environment variables for both local development and
# production deployment. Copy this to .env and customize for your deployment.
#
# IMPORTANT: Never commit .env with real credentials to version control.
#
# ============================================================================
# LOCAL DEVELOPMENT SETUP (default values)
# ============================================================================
# Use these settings when running `npm run dev` locally without Docker.

PORT=4000
NODE_ENV=development
HOST=localhost
MONGODB_URI=mongodb://localhost:27017/arcane_chess
CLIENT_ORIGIN=http://localhost:4000
GUEST_NAME_PREFIX=Guest

# ============================================================================
# DOCKER COMPOSE (VPS/Container) DEPLOYMENT
# ============================================================================
# Use these settings when deploying with `docker compose up -d`
# The docker-compose.yml already sets NODE_ENV=production, HOST=0.0.0.0,
# TRUST_PROXY=true, and SESSION_COOKIE_SECURE=false at container level.
# Override in this .env file if needed.
#
# Example for VPS deployment:
# NODE_ENV=production
# HOST=0.0.0.0
# PORT=4000
#
# For VPS deployment, MongoDB URI should point to the compose service:
# MONGODB_URI=mongodb://mongodb:27017/arcane_chess
#
# For HTTPS behind a reverse proxy (Nginx/Caddy), set the external domain:
# CLIENT_ORIGIN=https://arcane-chess.yourdomain.com

# ============================================================================
# PRODUCTION WITH MONGODB ATLAS (Cloud Mongo)
# ============================================================================
# If using MongoDB Atlas instead of a local/Compose MongoDB:
#
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/arcane_chess?retryWrites=true&w=majority
#
# Replace 'username', 'password', and 'cluster' with your Atlas credentials.

# ============================================================================
# SESSION & AUTHENTICATION
# ============================================================================

# Session cookie name (optional; defaults to 'arcane_session')
# SESSION_COOKIE_NAME=arcane_session

# Session lifetime in days (optional; defaults to 14)
# SESSION_TTL_DAYS=14

# ============================================================================
# OPTIONAL SETTINGS
# ============================================================================

# Guest user ID prefix (optional; defaults to 'Guest')
# GUEST_NAME_PREFIX=Guest

# Stockfish engine threads and hash memory (optional; defaults to 1 thread, 16MB hash)
# STOCKFISH_THREADS=1
# STOCKFISH_HASH_MB=16

